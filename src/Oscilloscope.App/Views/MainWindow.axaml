<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Oscilloscope.App.ViewModels"
        xmlns:views="using:Oscilloscope.App.Views"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Oscilloscope.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        RequestedThemeVariant="Dark"
        WindowState="Maximized"
        Width="1150" Height="700"
        Title="Oscilloscope">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.indicator">
            <Setter Property="Background" Value="#6B6B73" />
        </Style>
        <Style Selector="Border.indicator.connected">
            <Setter Property="Background" Value="#3FB950" />
        </Style>
        <Style Selector="Border.indicator.lost">
            <Setter Property="Background" Value="#F85149" />
        </Style>

        <!-- Every control has the same fixed height, so rows line up -->
        <Style Selector="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="SplitButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.info">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- "Advanced" buttons in the side panel; highlighted while their overlay is open -->
        <Style Selector="Button.advanced">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.advanced.active">
            <Setter Property="Background" Value="#40808080" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding RecordInfo}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Top bar: the panel toggle sits on the right edge -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6">

            <ToggleButton DockPanel.Dock="Right"
                          IsChecked="{Binding IsPanelOpen, Mode=TwoWay}"
                          ToolTip.Tip="Settings panel"
                          Width="40">
                <PathIcon Data="M3,5H21V7H3Z M3,11H21V13H3Z M3,17H21V19H3Z"
                          Width="16" Height="16" />
            </ToggleButton>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="indicator"
                            Classes.connected="{Binding IsConnected}"
                            Classes.lost="{Binding IsConnectionLost}"
                            Width="5" Height="28" CornerRadius="2"
                            VerticalAlignment="Center" />

                    <SplitButton Content="{Binding ConnectButtonText}"
                                 Command="{Binding ToggleConnectionCommand}"
                                 IsEnabled="{Binding CanToggleConnection}"
                                 MinWidth="120">
                        <SplitButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="8" Width="220">
                                    <TextBlock Text="Host" />
                                    <TextBox Text="{Binding Host}"
                                             IsEnabled="{Binding !IsConnected}" />
                                    <TextBlock Text="Port" />
                                    <TextBox Text="{Binding Port}"
                                             IsEnabled="{Binding !IsConnected}" />
                                </StackPanel>
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </StackPanel>

                <Button Content="Single"
                        Command="{Binding SingleCommand}"
                        IsEnabled="{Binding CanAcquire}" />
                <Button Content="Run"
                        Command="{Binding StartRunCommand}"
                        IsEnabled="{Binding CanAcquire}" />
                <Button Content="Force"
                        Command="{Binding ForceTriggerCommand}"
                        IsEnabled="{Binding IsRunning}" />
                <Button Content="Stop"
                        Command="{Binding StopRunCommand}"
                        IsEnabled="{Binding IsRunning}" />
                <Button Content="Debug"
                        Click="OnDebugClick"
                        IsEnabled="{Binding IsConnected}" />
                <Button x:Name="SaveButton"
                        Content="Save"
                        Click="OnSaveClick"
                        IsEnabled="False"
                        ToolTip.Tip="Save the samples visible on the plot to a CSV file" />
            </StackPanel>
        </DockPanel>

        <!-- Side panel: a fixed element with the channels and the trigger block -->
        <Border DockPanel.Dock="Right"
                IsVisible="{Binding IsPanelOpen}"
                Width="260"
                Background="#1E1E24"
                BorderBrush="#40808080"
                BorderThickness="1,0,0,0">
            <DockPanel Margin="8">

                <Button DockPanel.Dock="Bottom"
                        Content="Apply"
                        Command="{Binding ApplyTriggerCommand}"
                        IsEnabled="{Binding CanEditSettings}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0" />

                <ScrollViewer>
                    <StackPanel Spacing="8">

                        <!-- Both channel blocks are always open; the selected one is highlighted -->
                        <views:ChannelBlock DataContext="{Binding Channel1}" />
                        <views:ChannelBlock DataContext="{Binding Channel2}" />

                        <!-- Trigger block: sampling settings; source, edge and level are above the plot -->
                        <Grid>
                            <Border Background="#24242B" BorderBrush="#40808080"
                                    BorderThickness="1" CornerRadius="6" />

                            <StackPanel Margin="10,8,10,10" Spacing="6">

                                <Grid ColumnDefinitions="Auto,Auto,*">
                                    <Border Width="4" Height="18" CornerRadius="2"
                                            Background="#E5484D"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="Trigger"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="info"
                                               Text="{Binding TriggerSummary}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <StackPanel IsEnabled="{Binding CanEditSettings}" Spacing="6">
                                    <Grid ColumnDefinitions="82,*">
                                        <TextBlock Classes="label" Text="Length"
                                                   ToolTip.Tip="Record length: samples per channel (after decimation)." />
                                        <NumericUpDown Grid.Column="1" Value="{Binding RecordLength}"
                                                       Minimum="1" Maximum="{Binding MaxRecordLength}"
                                                       Increment="1024" FormatString="0" />
                                    </Grid>

                                    <Grid ColumnDefinitions="82,*">
                                        <TextBlock Classes="label" Text="Decimation"
                                                   ToolTip.Tip="Every Nth sample goes to the record. 1 = every sample." />
                                        <NumericUpDown Grid.Column="1" Value="{Binding Decimation}"
                                                       Minimum="1" Maximum="{Binding MaxDecimation}"
                                                       Increment="1" FormatString="0" />
                                    </Grid>

                                    <Grid ColumnDefinitions="82,*">
                                        <TextBlock Classes="label" Text="Hysteresis"
                                                   ToolTip.Tip="ADC codes. Set to 3 automatically on connect." />
                                        <NumericUpDown Grid.Column="1" Value="{Binding TriggerHysteresis}"
                                                       Minimum="0" Maximum="255" Increment="1"
                                                       FormatString="0" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Classes="info" Text="{Binding SampleRateText}" />
                                <TextBlock Classes="info" Text="{Binding RecordDurationText}" />

                                <Button Classes="advanced"
                                        Classes.active="{Binding IsTriggerAdvancedOpen}"
                                        Content="‹ Advanced"
                                        Command="{Binding ToggleTriggerAdvancedCommand}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel>

            <!-- Trigger bar above the plot -->
            <Border DockPanel.Dock="Top"
                    Background="#1E1E24"
                    BorderBrush="#40808080"
                    BorderThickness="0,0,0,1"
                    Padding="8,5">
                <StackPanel Orientation="Horizontal" Spacing="16"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding CanEditSettings}">

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="4" Height="18" CornerRadius="2"
                                Background="#E5484D" VerticalAlignment="Center" />
                        <TextBlock Text="Trigger" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Source" />
                        <ComboBox SelectedIndex="{Binding TriggerSourceIndex}" Width="84">
                            <ComboBoxItem Content="CH1" />
                            <ComboBoxItem Content="CH2" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Edge" />
                        <ComboBox SelectedIndex="{Binding TriggerEdgeIndex}" Width="104">
                            <ComboBoxItem Content="Rising" />
                            <ComboBoxItem Content="Falling" />
                            <ComboBoxItem Content="Both" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Level" />
                        <NumericUpDown Value="{Binding TriggerLevel}"
                                       Minimum="0" Maximum="255" Increment="1"
                                       FormatString="0" Width="110"
                                       ToolTip.Tip="ADC code, 0 to 255. You can also drag the red line on the plot." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Mode" />
                        <ComboBox SelectedIndex="0" IsEnabled="False" Width="104"
                                  ToolTip.Tip="Available when the firmware supports it"
                                  ToolTip.ShowOnDisabled="True">
                            <ComboBoxItem Content="Normal" />
                            <ComboBoxItem Content="Auto" />
                            <ComboBoxItem Content="Single" />
                        </ComboBox>
                    </StackPanel>

                    <Button Content="Apply" Command="{Binding ApplyTriggerCommand}" />
                </StackPanel>
            </Border>

            <!-- Plot, with the advanced overlay floating over its right edge (left of the side panel) -->
            <Grid>
                <sp:AvaPlot x:Name="Plot" />

                <Border IsVisible="{Binding IsAdvancedOpen}"
                        Width="280"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,8"
                        Padding="12"
                        Background="#B31E1E24"
                        BorderBrush="#40808080"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>

                        <!-- Trigger: advanced -->
                        <StackPanel IsVisible="{Binding IsTriggerAdvancedOpen}" Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,28,4">
                                <Border Width="4" Height="18" CornerRadius="2"
                                        Background="#E5484D"
                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="Trigger - advanced"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="90,*" IsEnabled="{Binding CanEditSettings}">
                                <TextBlock Classes="label" Text="Pretrigger"
                                           ToolTip.Tip="Samples kept from before the trigger. You can also drag the grey line on the plot." />
                                <NumericUpDown Grid.Column="1" Value="{Binding Pretrigger}"
                                               Minimum="0" Maximum="{Binding MaxPretrigger}"
                                               Increment="256" FormatString="0" />
                            </Grid>

                            <Grid ColumnDefinitions="90,*">
                                <TextBlock Classes="label" Text="Holdoff" />
                                <NumericUpDown Grid.Column="1" IsEnabled="False"
                                               ToolTip.Tip="Available when the firmware supports it"
                                               ToolTip.ShowOnDisabled="True" />
                            </Grid>
                        </StackPanel>

                        <!-- Channels: advanced -->
                        <Panel IsVisible="{Binding IsChannel1AdvancedOpen}">
                            <views:ChannelAdvanced DataContext="{Binding Channel1}" />
                        </Panel>
                        <Panel IsVisible="{Binding IsChannel2AdvancedOpen}">
                            <views:ChannelAdvanced DataContext="{Binding Channel2}" />
                        </Panel>

                        <!-- Close -->
                        <Button Content="×"
                                FontSize="16"
                                Padding="8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding CloseAdvancedCommand}" />
                    </Grid>
                </Border>
            </Grid>

        </DockPanel>
    </DockPanel>
</Window>