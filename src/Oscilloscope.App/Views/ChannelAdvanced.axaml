<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oscilloscope.App.ViewModels"
             x:Class="Oscilloscope.App.Views.ChannelAdvanced"
             x:DataType="vm:ChannelViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="#F85149" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,28,4">
            <Border Width="4" Height="18" CornerRadius="2"
                    Background="{Binding Accent}"
                    VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center">
                <Run Text="{Binding Title}" />
                <Run Text=" - advanced" />
            </TextBlock>
        </Grid>

        <TextBlock Text="Status from the device" Opacity="0.6" Margin="0,4,0,0" />
        <TextBlock Text="{Binding AppliedGainText}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding AppliedOffsetText}" />
        <TextBlock Text="{Binding OverrangeText}" Classes.warn="{Binding IsOverrange}" />
        <TextBlock Text="{Binding BusyText}" Opacity="0.7" />

        <TextBlock Text="Refreshed every 0.5 s while this panel is open."
                   FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,4,0,0" />

        <Button Content="Voltage calibration..."
                Click="OnVoltageCalibrationClick"
                IsEnabled="{Binding CanEdit}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,8,0,0" />

        <Button Content="DC offset vs gain..."
                Click="OnCalibrationClick"
                IsEnabled="{Binding CanEdit}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
    </StackPanel>
</UserControl>