<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oscilloscope.App.ViewModels"
             x:Class="Oscilloscope.App.Views.ChannelBlock"
             x:DataType="vm:ChannelViewModel">

    <Grid>
        <!-- Card background -->
        <Border Background="#24242B" BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" />

        <!-- Highlight when selected: a tint and an outline in the channel color -->
        <Border Background="{Binding Accent}" Opacity="0.12" CornerRadius="6"
                IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
        <Border BorderBrush="{Binding Accent}" BorderThickness="2" CornerRadius="6"
                IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />

        <StackPanel>

            <!-- Header: always visible, a click selects the block -->
            <Border Background="Transparent" Cursor="Hand" Padding="10,8"
                    Tapped="OnHeaderTapped">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="4" Height="18" CornerRadius="2"
                            Background="{Binding Accent}"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="2" Content="Enabled"
                              IsChecked="{Binding IsEnabled}"
                              IsEnabled="{Binding CanEdit}" />
                </Grid>
            </Border>

            <!-- Body: only for the selected block -->
            <StackPanel IsVisible="{Binding IsSelected}" Spacing="8" Margin="10,0,10,10">

                <StackPanel IsEnabled="{Binding CanEdit}" Spacing="8">
                    <TextBlock Text="Gain (raw word)" />
                    <NumericUpDown Value="{Binding Gain}"
                                   Minimum="0" Maximum="511" Increment="1" FormatString="0"
                                   ToolTip.Tip="Raw AD8370 gain word with the range bit. Conversion to dB is not defined yet." />

                    <TextBlock Text="Offset (DAC code)" />
                    <NumericUpDown Value="{Binding Offset}"
                                   Minimum="0" Maximum="4095" Increment="16" FormatString="0"
                                   ToolTip.Tip="MCP4822 code, 0 to 4095." />
                </StackPanel>

                <Button Classes="advanced"
                        Classes.active="{Binding IsAdvancedOpen}"
                        Content="‹ Advanced"
                        Click="OnAdvancedClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>