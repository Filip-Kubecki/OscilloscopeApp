<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oscilloscope.App.ViewModels"
             x:Class="Oscilloscope.App.Views.ChannelBlock"
             x:DataType="vm:ChannelViewModel">

    <!-- A tap anywhere in the block highlights it (selects the channel) -->
    <Grid Tapped="OnTapped">

        <!-- Card background -->
        <Border Background="#24242B" BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" />

        <!-- Highlight when selected: a tint and an outline in the channel color -->
        <Border Background="{Binding Accent}" Opacity="0.12" CornerRadius="6"
                IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
        <Border BorderBrush="{Binding Accent}" BorderThickness="2" CornerRadius="6"
                IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />

        <StackPanel Margin="10,8,10,10" Spacing="6">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="4" Height="18" CornerRadius="2"
                        Background="{Binding Accent}"
                        VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <CheckBox Grid.Column="2" Content="Enabled"
                          IsChecked="{Binding IsEnabled}"
                          IsEnabled="{Binding CanEdit}" />
            </Grid>

            <!-- Settings: label and field in one row -->
            <StackPanel IsEnabled="{Binding CanEdit}" Spacing="6">
                <Grid ColumnDefinitions="52,*">
                    <TextBlock Classes="label" Text="Gain"
                               ToolTip.Tip="AD8370 gain word: 0-127 low range, 128-255 high range (bit 7 selects the range)." />
                    <NumericUpDown Grid.Column="1" Value="{Binding Gain}"
                                   Minimum="0" Maximum="255" Increment="1" FormatString="0" />
                </Grid>
                <Grid ColumnDefinitions="52,*">
                    <TextBlock Classes="label" Text="Offset"
                               ToolTip.Tip="MCP4822 code, 0 to 4095." />
                    <NumericUpDown Grid.Column="1" Value="{Binding Offset}"
                                   Minimum="0" Maximum="4095" Increment="16" FormatString="0" />
                </Grid>
            </StackPanel>

            <Button Classes="advanced"
                    Classes.active="{Binding IsAdvancedOpen}"
                    Content="‹ Advanced"
                    Click="OnAdvancedClick" />
        </StackPanel>
    </Grid>
</UserControl>