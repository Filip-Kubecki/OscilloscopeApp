<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Oscilloscope.App.ViewModels"
        xmlns:views="using:Oscilloscope.App.Views"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Oscilloscope.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        RequestedThemeVariant="Dark"
        Width="1150" Height="700"
        Title="Oscilloscope">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.indicator">
            <Setter Property="Background" Value="#6B6B73" />
        </Style>
        <Style Selector="Border.indicator.connected">
            <Setter Property="Background" Value="#3FB950" />
        </Style>
        <Style Selector="Border.indicator.lost">
            <Setter Property="Background" Value="#F85149" />
        </Style>

        <!-- "Advanced" buttons in the side panel; highlighted while their overlay is open -->
        <Style Selector="Button.advanced">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.advanced.active">
            <Setter Property="Background" Value="#40808080" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding RecordInfo}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Top bar: the panel toggle sits on the right edge -->
        <DockPanel DockPanel.Dock="Top" Margin="8">

            <ToggleButton DockPanel.Dock="Right"
                          IsChecked="{Binding IsPanelOpen, Mode=TwoWay}"
                          ToolTip.Tip="Settings panel"
                          Padding="10,8"
                          VerticalAlignment="Center">
                <PathIcon Data="M3,5H21V7H3Z M3,11H21V13H3Z M3,17H21V19H3Z"
                          Width="16" Height="16" />
            </ToggleButton>

            <StackPanel Orientation="Horizontal" Spacing="8">

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="indicator"
                            Classes.connected="{Binding IsConnected}"
                            Classes.lost="{Binding IsConnectionLost}"
                            Width="5" CornerRadius="2" />

                    <SplitButton Content="{Binding ConnectButtonText}"
                                 Command="{Binding ToggleConnectionCommand}"
                                 IsEnabled="{Binding CanToggleConnection}"
                                 MinWidth="120">
                        <SplitButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="8" Width="220">
                                    <TextBlock Text="Host" />
                                    <TextBox Text="{Binding Host}"
                                             IsEnabled="{Binding !IsConnected}" />
                                    <TextBlock Text="Port" />
                                    <TextBox Text="{Binding Port}"
                                             IsEnabled="{Binding !IsConnected}" />
                                </StackPanel>
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </StackPanel>

                <Button Content="Single"
                        Command="{Binding SingleCommand}"
                        IsEnabled="{Binding CanAcquire}" />
                <Button Content="Run"
                        Command="{Binding StartRunCommand}"
                        IsEnabled="{Binding CanAcquire}" />
                <Button Content="Force"
                        Command="{Binding ForceTriggerCommand}"
                        IsEnabled="{Binding IsRunning}" />
                <Button Content="Stop"
                        Command="{Binding StopRunCommand}"
                        IsEnabled="{Binding IsRunning}" />
                <Button Content="Debug"
                        Click="OnDebugClick"
                        IsEnabled="{Binding IsConnected}" />
            </StackPanel>
        </DockPanel>

        <!-- Side panel: a fixed element, the plot takes the remaining space -->
        <Border DockPanel.Dock="Right"
                IsVisible="{Binding IsPanelOpen}"
                Width="290"
                Background="#1E1E24"
                BorderBrush="#40808080"
                BorderThickness="1,0,0,0">
            <DockPanel Margin="8">

                <Button DockPanel.Dock="Bottom"
                        Content="Apply"
                        Command="{Binding ApplyTriggerCommand}"
                        IsEnabled="{Binding CanEditSettings}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0" />

                <ScrollViewer>
                    <StackPanel Spacing="8">

                        <!-- Trigger block: always open -->
                        <Grid>
                            <Border Background="#24242B" BorderBrush="#40808080"
                                    BorderThickness="1" CornerRadius="6" />

                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*" Margin="10,8">
                                    <Border Width="4" Height="28" CornerRadius="2"
                                            Background="#E5484D"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Trigger" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TriggerSummary}"
                                                   FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="8" Margin="10,0,10,10">

                                    <StackPanel IsEnabled="{Binding CanEditSettings}" Spacing="8">
                                        <TextBlock Text="Source" />
                                        <ComboBox SelectedIndex="{Binding TriggerSourceIndex}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Channel 1" />
                                            <ComboBoxItem Content="Channel 2" />
                                        </ComboBox>

                                        <TextBlock Text="Edge" />
                                        <ComboBox SelectedIndex="{Binding TriggerEdgeIndex}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Rising" />
                                            <ComboBoxItem Content="Falling" />
                                            <ComboBoxItem Content="Both" />
                                        </ComboBox>

                                        <TextBlock Text="Level (ADC code)" />
                                        <NumericUpDown Value="{Binding TriggerLevel}"
                                                       Minimum="0" Maximum="255" Increment="1"
                                                       FormatString="0" />

                                        <TextBlock Text="Pretrigger (samples)" />
                                        <NumericUpDown Value="{Binding Pretrigger}"
                                                       Minimum="0" Maximum="{Binding MaxPretrigger}"
                                                       Increment="256" FormatString="0" />

                                        <TextBlock Text="Mode" />
                                        <ComboBox SelectedIndex="0" IsEnabled="False"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Available when the firmware supports it"
                                                  ToolTip.ShowOnDisabled="True">
                                            <ComboBoxItem Content="Normal" />
                                            <ComboBoxItem Content="Auto" />
                                            <ComboBoxItem Content="Single" />
                                        </ComboBox>
                                    </StackPanel>

                                    <Button Classes="advanced"
                                            Classes.active="{Binding IsTriggerAdvancedOpen}"
                                            Content="‹ Advanced"
                                            Command="{Binding ToggleTriggerAdvancedCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Channel blocks: one of them is open -->
                        <views:ChannelBlock DataContext="{Binding Channel1}" />
                        <views:ChannelBlock DataContext="{Binding Channel2}" />

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Plot, with the advanced overlay floating over its right edge (left of the side panel) -->
        <Grid>
            <sp:AvaPlot x:Name="Plot" />

            <Border IsVisible="{Binding IsAdvancedOpen}"
                    Width="270"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,8"
                    Padding="12"
                    Background="#B31E1E24"
                    BorderBrush="#40808080"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>

                    <!-- Trigger: advanced -->
                    <StackPanel IsVisible="{Binding IsTriggerAdvancedOpen}" Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,28,0">
                            <Border Width="4" Height="18" CornerRadius="2"
                                    Background="#E5484D"
                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="Trigger - advanced"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel IsEnabled="{Binding CanEditSettings}" Spacing="8">
                            <TextBlock Text="Record length (samples)" />
                            <NumericUpDown Value="{Binding RecordLength}"
                                           Minimum="1" Maximum="{Binding MaxRecordLength}"
                                           Increment="1024" FormatString="0" />

                            <TextBlock Text="Hysteresis (ADC code)" />
                            <NumericUpDown Value="{Binding TriggerHysteresis}"
                                           Minimum="0" Maximum="255" Increment="1"
                                           FormatString="0" />
                        </StackPanel>

                        <TextBlock Text="Decimation" />
                        <NumericUpDown IsEnabled="False"
                                       ToolTip.Tip="Not wired up in the app yet"
                                       ToolTip.ShowOnDisabled="True" />

                        <TextBlock Text="Holdoff (samples)" />
                        <NumericUpDown IsEnabled="False"
                                       ToolTip.Tip="Available when the firmware supports it"
                                       ToolTip.ShowOnDisabled="True" />
                    </StackPanel>

                    <!-- Channels: advanced -->
                    <Panel IsVisible="{Binding IsChannel1AdvancedOpen}">
                        <views:ChannelAdvanced DataContext="{Binding Channel1}" />
                    </Panel>
                    <Panel IsVisible="{Binding IsChannel2AdvancedOpen}">
                        <views:ChannelAdvanced DataContext="{Binding Channel2}" />
                    </Panel>

                    <!-- Close -->
                    <Button Content="×"
                            FontSize="16"
                            Padding="8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding CloseAdvancedCommand}" />
                </Grid>
            </Border>
        </Grid>

    </DockPanel>
</Window>
